{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["vitest/globals"]
  },
  // Edge Functions are Deno, with their own globals and `jsr:` specifiers.
  // They are typechecked by `deno check`, not by this config.
  "include": ["src"]
}
